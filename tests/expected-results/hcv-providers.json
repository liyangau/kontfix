{
  "providers": [
    {
      "provider": "konnect",
      "alias": "au",
      "personal_access_token": "${var.cp_admin_token}",
      "server_url": "https://au.api.konghq.com"
    },
    {
      "provider": "vault",
      "address": "https://vault.example.com",
      "alias": "storage",
      "token": "${var.vault_token}"
    },
    {
      "provider": "vault",
      "address": "https://vault.example.com",
      "alias": "pki",
      "auth_login": {
        "parameters": {
          "role_id": "${var.vault_pki_role_id}",
          "secret_id": "${var.vault_pki_secret_id}"
        },
        "path": "auth/pki/login"
      }
    }
  ],
  "variables": [
    {
      "variable_name": "cp_admin_token"
    },
    {
      "variable_name": "vault_token"
    },
    {
      "variable_name": "vault_pki_role_id"
    },
    {
      "variable_name": "vault_pki_secret_id"
    }
  ],
  "required_providers": [
    {"name": "konnect", "source": "Kong/konnect", "version": "3.3.0"},
    {"name": "time", "source": "hashicorp/time", "version": "0.13.1"},
    {"name": "vault", "source": "hashicorp/vault", "version": "5.3.0"}
  ]
}
